{
  "version": "1.0.0",
  "environments": {
    "dev": {
      "name": "Development",
      "description": "로컬 개발 환경",
      "auto_deploy": false,
      "requires_approval": false,
      "notifications": false,
      "health_check": false
    },
    "staging": {
      "name": "Staging",
      "description": "배포 전 검증 환경",
      "auto_deploy": true,
      "requires_approval": false,
      "notifications": true,
      "health_check": true,
      "health_check_timeout": 60
    },
    "prod": {
      "name": "Production",
      "description": "실제 서비스 환경",
      "auto_deploy": false,
      "requires_approval": true,
      "notifications": true,
      "health_check": true,
      "health_check_timeout": 120,
      "rollback_on_failure": true
    }
  },
  "projects": {
    "ai-note-taking": {
      "type": "nextjs",
      "environments": {
        "dev": {
          "url": "http://localhost:3000",
          "branch": "develop"
        },
        "staging": {
          "url": "https://ai-note-taking-staging.vercel.app",
          "branch": "staging"
        },
        "prod": {
          "url": "https://ai-note-taking.vercel.app",
          "branch": "main"
        }
      }
    },
    "claude-code-auto": {
      "type": "npm-package",
      "environments": {
        "dev": {
          "registry": "http://localhost:4873",
          "branch": "develop"
        },
        "prod": {
          "registry": "https://registry.npmjs.org",
          "branch": "main"
        }
      }
    },
    "docker-n8n": {
      "type": "docker-compose",
      "environments": {
        "prod": {
          "url": "https://n8n.krdn.kr",
          "compose_file": "docker-compose.yml",
          "branch": "main"
        }
      },
      "special_instructions": [
        "프로덕션 전용 - 백업 필수",
        "업무 외 시간 배포 권장",
        "systemd 타이머로 자동 업데이트 가능"
      ]
    },
    "news-sentiment-analyzer": {
      "type": "docker-compose",
      "environments": {
        "dev": {
          "compose_file": "docker-compose.yml"
        },
        "prod": {
          "url": "https://news.krdn.kr",
          "compose_file": "docker-compose.prod.yml",
          "branch": "main"
        }
      }
    },
    "home": {
      "type": "nextjs",
      "environments": {
        "dev": {
          "url": "http://localhost:3000",
          "branch": "develop"
        },
        "prod": {
          "url": "https://krdn.kr",
          "branch": "main"
        }
      }
    },
    "home-krdn": {
      "type": "nextjs",
      "environments": {
        "dev": {
          "url": "http://localhost:3001",
          "branch": "develop"
        }
      }
    },
    "gonsai2": {
      "type": "express",
      "environments": {
        "dev": {
          "url": "http://localhost:3002",
          "branch": "develop"
        },
        "prod": {
          "pm2_name": "gonsai2",
          "branch": "main"
        }
      }
    }
  },
  "notifications": {
    "channels": ["email"],
    "on_success": true,
    "on_failure": true,
    "skill": "notify-important"
  },
  "safety": {
    "require_clean_git": true,
    "require_tests_pass": true,
    "require_build_success": true,
    "max_rollback_versions": 5,
    "auto_rollback_on_health_failure": true
  }
}
