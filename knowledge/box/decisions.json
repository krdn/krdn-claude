  "decisions": [
    {
      "id": "adr-001",
      "title": "트리 구조 에이전트 시스템 채택",
      "date": "2026-01-08",
      "status": "accepted",
      "context": "다양한 개발 프로젝트(AI, N8N, Web)를 효율적으로 관리하기 위한 시스템이 필요. 프로젝트 간 컨텍스트 스위칭 비용이 높고, 배포/모니터링이 분산되어 있어 통합 관리 체계가 요구됨.",
      "decision": "계층적 트리 구조 에이전트 시스템 도입. Orchestrator를 루트로 하고, 도메인별 Manager 에이전트(AI, N8N, Web)가 하위 프로젝트를 관리하는 구조 채택.",
      "consequences": {
        "positive": [
          "도메인별 전문화된 관리 가능",
          "토큰 비용 최적화 (모델 계층화: opus > sonnet > haiku)",
          "확장성 확보 (새 도메인 추가 용이)",
          "책임 분리로 유지보수성 향상"
        ],
        "negative": [
          "초기 설정 복잡도 증가",
          "에이전트 간 통신 오버헤드",
          "학습 곡선 존재"
        ]
      },
      "alternatives": [
        {
          "option": "단일 에이전트로 모든 프로젝트 관리",
          "reason_rejected": "컨텍스트 윈도우 한계, 전문성 부족"
        },
        {
          "option": "프로젝트별 독립 에이전트",
          "reason_rejected": "중복 설정, 크로스 프로젝트 작업 어려움"
        }
      ],
      "related_projects": ["claude-code-auto", "ai-note-taking", "docker-n8n", "home"],
      "tags": ["architecture", "agent-system", "scalability"]
    },
    {
      "id": "adr-002",
      "title": "모델 계층화 전략",
      "date": "2026-01-08",
      "status": "accepted",
      "context": "에이전트 시스템에서 토큰 비용을 최적화하면서도 복잡한 작업은 고성능 모델로 처리해야 함.",
      "decision": "역할별 모델 할당: Orchestrator(opus) - 복잡한 의사결정, Domain Managers(sonnet) - 실제 작업 수행, Monitor(haiku) - 단순 상태 체크",
      "consequences": {
        "positive": [
          "비용 효율성 (단순 작업에 저렴한 모델 사용)",
          "응답 속도 최적화 (경량 모델 사용 시 빠른 응답)",
          "적재적소 성능 (복잡한 작업에만 고성능 모델)"
        ],
        "negative": [
          "하위 모델의 능력 한계 가능성",
          "모델 간 응답 품질 차이"
        ]
      },
      "alternatives": [
        {
          "option": "모든 에이전트에 동일 모델 사용",
          "reason_rejected": "비용 비효율, 단순 작업에 과도한 리소스"
        }
      ],
      "related_projects": [],
      "tags": ["cost-optimization", "model-selection"]
    }
